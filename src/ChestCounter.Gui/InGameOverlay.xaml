<Window x:Class="ChestCounter.Gui.InGameOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chest Tracker overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnDrag" UseLayoutRounding="True">
    <Border Width="236" CornerRadius="10" Padding="18,15,20,13" Margin="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1">
                <GradientStop Color="#F20D0D0E" Offset="0"/>
                <GradientStop Color="#F5050505" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="0">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="TitleText" Text="Chest Tracker" Foreground="#F3F1EC"
                               FontSize="13" FontWeight="Bold"/>
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Fill="#FF3D6B"/>
                </Grid>
                <TextBlock Text="Chests this match" Foreground="#8A8A90" FontSize="11.5" Margin="0,12,0,0"/>
                <TextBlock x:Name="LiveText" Text="—" x:FieldModifier="private"
                           Foreground="#F3F1EC" FontSize="64" FontWeight="SemiBold" FontFamily="Bahnschrift Condensed, Bahnschrift"
                           Margin="0,-4,0,0"/>
                <Border Height="1" Background="#26262A" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="Average" Foreground="#8A8A90" FontSize="11"/>
                        <TextBlock x:Name="AvgText" Text="0.0" Foreground="#F3F1EC" FontSize="21" FontWeight="SemiBold" FontFamily="Bahnschrift Condensed, Bahnschrift"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Last game" Foreground="#8A8A90" FontSize="11"/>
                        <TextBlock x:Name="LastText" Text="—" Foreground="#F3F1EC" FontSize="21" FontWeight="SemiBold" FontFamily="Bahnschrift Condensed, Bahnschrift"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="HintText" Text="Ctrl+Shift+O hide · Ctrl+Shift+L lock"
                           Foreground="#5A5A60" FontSize="9.5" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Border>
</Window>
