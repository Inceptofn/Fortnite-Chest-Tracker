<Window x:Class="ChestCounter.Gui.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player stats" Width="1040" Height="760" MinWidth="480" MinHeight="420"
        ResizeMode="CanResize" Icon="chest.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- Same approach as the main window: PlayerWindow.ApplyLayout() rearranges the page from its size. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="Page_SizeChanged">
        <Grid x:Name="Root" Margin="28,22,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: who, and the period filter -->
            <Grid x:Name="HeaderGrid" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="TitleStack">
                    <TextBlock Text="Played with" Style="{StaticResource Label}"/>
                    <TextBlock x:Name="NameText" Style="{StaticResource Figure}" FontSize="34" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Chests opened per match, as seen from your replays. A teammate's count is a minimum: a chest opened far from you never reaches your replay."
                               Style="{StaticResource Label}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="FilterBar" Background="{StaticResource Card}" CornerRadius="9" Padding="3"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="F0" Style="{StaticResource Pill}" Content="24 hours" GroupName="pf" Checked="Filter_Checked"/>
                        <RadioButton x:Name="F1" Style="{StaticResource Pill}" Content="7 days"   GroupName="pf" Checked="Filter_Checked"/>
                        <RadioButton x:Name="F2" Style="{StaticResource Pill}" Content="Season"   GroupName="pf" Checked="Filter_Checked"/>
                        <RadioButton x:Name="F3" Style="{StaticResource Pill}" Content="All time" GroupName="pf" Checked="Filter_Checked"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stat cards -->
            <UniformGrid x:Name="StatsGrid" Grid.Row="1" Columns="5" Margin="0,18,-8,0">
                <Border Style="{StaticResource Panel}" Padding="20,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Games together" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="GamesText" Text="0" Style="{StaticResource Figure}" FontSize="36"/>
                        <TextBlock x:Name="GamesSubText" Text="" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Chests" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="TotalText" Text="0" Style="{StaticResource Figure}" FontSize="36"/>
                        <TextBlock x:Name="TotalSubText" Text="" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Average" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="AvgText" Text="0.0" Style="{StaticResource Figure}" FontSize="36"/>
                        <TextBlock x:Name="AvgSubText" Text="" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Best game" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="BestText" Text="0" Style="{StaticResource Figure}" FontSize="36" Foreground="{StaticResource Gem}"/>
                        <TextBlock x:Name="BestWhenText" Text="" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="20,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="Last game" Style="{StaticResource Label}"/>
                        <TextBlock x:Name="LastText" Text="&#8212;" Style="{StaticResource Figure}" FontSize="36"/>
                        <TextBlock x:Name="LastWhenText" Text="" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Chart + game list -->
            <Grid x:Name="BodyGrid" Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ListCol" Width="340"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="ChartPanel" Grid.Column="0" Grid.Row="0" Style="{StaticResource Panel}" Padding="24,18,24,20" MinHeight="220">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Chests per match" Foreground="{StaticResource Text}" FontSize="13.5"/>
                            <TextBlock x:Name="ChartMetaText" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="NoDataText" Grid.Row="1" Text="No games together in this period."
                                   Style="{StaticResource Label}" FontSize="13" Visibility="Collapsed"/>
                        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Stroke}"/>
                        <ItemsControl x:Name="ChartBars" Grid.Row="1" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Tip}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding Top}"/>
                                            <RowDefinition Height="{Binding Bottom}"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        <Border Grid.Row="1" Margin="3,0" MaxWidth="30" MinHeight="3" CornerRadius="3,3,0,0" Background="{Binding Fill}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border x:Name="ListPanel" Grid.Column="1" Grid.Row="0" Style="{StaticResource Panel}" Margin="16,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Game by game" Foreground="{StaticResource Text}" FontSize="13.5"/>
                        <Grid Grid.Row="1" Margin="0,10,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date" Style="{StaticResource Label}" FontSize="11.5"/>
                            <TextBlock x:Name="PlayerColText" Grid.Column="1" Text="Them" Style="{StaticResource Label}" FontSize="11.5"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="You" Style="{StaticResource Label}" FontSize="11.5" HorizontalAlignment="Right"/>
                        </Grid>
                        <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="ListScroll_PreviewMouseWheel">
                            <StackPanel>
                                <ItemsControl x:Name="GameList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding When}" Foreground="{StaticResource Steel}" FontSize="12.5" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Chests}" FontFamily="{StaticResource Display}"
                                                           Foreground="{StaticResource Text}" FontSize="18" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text="{Binding You}" Style="{StaticResource Label}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ListEmptyText" Text="Nothing to list for this period." Style="{StaticResource Label}"
                                           Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="3" Margin="0,14,0,0">
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="PrizeTitleText" Text="Treasures from their chests" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="PrizeList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Label}" Margin="0,2" TextWrapping="Wrap">
                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Text}"/>
                                            <Run Text="{Binding Value, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="PrizeEmptyText" Text="None seen in this period." Style="{StaticResource Label}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
