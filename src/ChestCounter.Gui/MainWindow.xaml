<Window x:Class="ChestCounter.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chest Tracker" Width="1280" Height="930" MinWidth="520" MinHeight="480"
        ResizeMode="CanResize" Icon="chest.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- The page scrolls when the window is too small for the layout; MainWindow.ApplyLayout() picks the arrangement from the window size. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="Page_SizeChanged">
    <Grid x:Name="Root" Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="Chest Tracker" FontFamily="{StaticResource Display}" Foreground="{StaticResource Text}"
                       FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <WrapPanel x:Name="HeaderActions" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,-6">
                <Border Background="{StaticResource Card}" CornerRadius="9" Padding="3" Margin="0,0,12,6">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="F0" Style="{StaticResource Pill}" Content="24 hours" Tag="0" GroupName="f" Checked="Filter_Checked"/>
                        <RadioButton x:Name="F1" Style="{StaticResource Pill}" Content="7 days"   Tag="1" GroupName="f" Checked="Filter_Checked"/>
                        <RadioButton x:Name="F2" Style="{StaticResource Pill}" Content="Season"   Tag="2" GroupName="f" Checked="Filter_Checked" IsChecked="True"/>
                        <RadioButton x:Name="F3" Style="{StaticResource Pill}" Content="All time" Tag="3" GroupName="f" Checked="Filter_Checked"/>
                    </StackPanel>
                </Border>
                <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource Quiet}" Margin="0,0,8,6" Click="ResetButton_Click"
                        ToolTip="Delete all saved matches"/>
                <Button x:Name="LiveButton" Content="Live counter on" Style="{StaticResource Quiet}" Margin="0,0,0,6" Click="LiveButton_Click"/>
                <Button x:Name="ScanButton" Content="Scan replays" Style="{StaticResource Primary}" Margin="8,0,0,6" Click="ScanButton_Click"/>
            </WrapPanel>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SideCol" Width="392"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LEFT -->
            <Grid x:Name="LeftGrid" Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="ChartRow" Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hero: the live count, with the chest -->
                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeroTop" Grid.Row="0" Height="184">
                            <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0">
                                <Ellipse Width="460" Height="340" Canvas.Left="-350" Canvas.Top="-60">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#3DFF3D6B" Offset="0"/>
                                            <GradientStop Color="#00FF3D6B" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Canvas>
                            <Image x:Name="HeroChest" Source="chest.png" Width="156" Height="156" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,4,40,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel x:Name="HeroText" Margin="30,20,220,10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Gem}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <TextBlock Text="This game" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                </StackPanel>
                                <TextBlock x:Name="ThisGameText" Text="—" Style="{StaticResource Figure}" FontSize="98" FontWeight="Bold" Margin="-3,-12,0,-10"/>
                                <TextBlock x:Name="ThisGameSubText" Text="waiting for a match…" Style="{StaticResource Label}" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Background="#0AFFFFFF">
                            <UniformGrid x:Name="HeroStats" Columns="4">
                                <StackPanel Margin="30,12,12,12">
                                    <TextBlock Text="Average" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="AvgYouText" Text="0.0" Style="{StaticResource Figure}"/>
                                    <TextBlock x:Name="RecentFormText" Text="" Style="{StaticResource Label}" FontSize="11.5"/>
                                </StackPanel>
                                <Border x:Name="StatB2" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
                                    <StackPanel Margin="22,12,12,12">
                                        <TextBlock Text="Opened" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="YourTotalText" Text="0" Style="{StaticResource Figure}"/>
                                        <TextBlock x:Name="MatchesText" Text="" Style="{StaticResource Label}" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatB3" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
                                    <StackPanel Margin="22,12,12,12">
                                        <TextBlock Text="Last game" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="LastGameText" Text="—" Style="{StaticResource Figure}"/>
                                        <TextBlock x:Name="LastMatchText" Text="" Style="{StaticResource Label}" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="StatB4" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
                                    <StackPanel Margin="22,12,12,12">
                                        <TextBlock Text="Best game" Style="{StaticResource Label}"/>
                                        <TextBlock x:Name="BestText" Text="0" Style="{StaticResource Figure}" Foreground="{StaticResource Gem}"/>
                                        <TextBlock x:Name="BestWhenText" Text="" Style="{StaticResource Label}" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Chart: takes whatever height is left -->
                <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="24,18,24,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Chests per match" Foreground="{StaticResource Text}" FontSize="13.5"/>
                            <TextBlock x:Name="ChartMetaText" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="NoDataText" Grid.Row="1" Text="No matches yet. Press Scan replays to read the ones Fortnite has saved."
                                   Style="{StaticResource Label}" FontSize="13" Visibility="Collapsed"/>
                        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Stroke}"/>
                        <ItemsControl x:Name="ChartBars" Grid.Row="1" Margin="0,16,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Tip}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding Top}"/>
                                            <RowDefinition Height="{Binding Bottom}"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                        <Border Grid.Row="1" Margin="3,0" MaxWidth="30" MinHeight="3" CornerRadius="3,3,0,0" Background="{Binding Fill}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Squad -->
                <Grid x:Name="SquadGrid" Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="SquadPanel" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,8,0" MinHeight="150">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Squad, last game" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                <TextBlock x:Name="SquadTotalText" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl x:Name="SquadList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PlayerLink}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,64,0" VerticalAlignment="Center" MouseLeftButtonUp="PlayerName_Click"/>
                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Display}" Foreground="{StaticResource Text}" FontSize="19" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="SquadEmptyText" Text="No squad match here yet. Scan replays to pull in your teammates." Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="MatesPanel" Grid.Column="1" Style="{StaticResource Panel}" Margin="8,0,0,0" MinHeight="150">
                        <StackPanel>
                            <TextBlock Text="Most played with" Foreground="{StaticResource Text}" FontSize="13.5"/>
                            <ItemsControl x:Name="MatesList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PlayerLink}" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,160,0" MouseLeftButtonUp="PlayerName_Click"/>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MatesEmptyText" Text="Shows who you loot with most, once there are squad matches." Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- RIGHT -->
            <ScrollViewer x:Name="SideScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="SideScroll_PreviewMouseWheel">
                <StackPanel>
                    <Border Style="{StaticResource Panel}" Padding="0">
                        <StackPanel>
                            <!-- Treasure Hour: turns gem while live -->
                            <Border x:Name="HourBorder" Background="{StaticResource CardAlt}" CornerRadius="13,13,0,0" Padding="24,18,24,18">
                                <StackPanel>
                                    <TextBlock x:Name="HourTitleText" Text="Next Treasure Hour" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                    <TextBlock x:Name="HourCountdownText" Text="" FontFamily="{StaticResource Display}" Foreground="{StaticResource Text}"
                                               FontSize="52" FontWeight="SemiBold" Margin="-2,-2,0,0"/>
                                    <TextBlock x:Name="HourBoostText" Text="" Foreground="{StaticResource Text}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="24,18,24,20">
                                <Grid>
                                    <TextBlock x:Name="WeekText" Text="Odds per chest" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                    <TextBlock Text="your luck so far" Style="{StaticResource Label}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               ToolTip="Chance you would have pulled at least one by now, from the chests you opened this season."/>
                                </Grid>
                                <ItemsControl x:Name="OddsList" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Item}" Style="{StaticResource Label}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Odds}" Foreground="{Binding OddsBrush}" FontFamily="{StaticResource Display}"
                                                           FontSize="19" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Luck}" Foreground="{StaticResource Steel}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,12,0,12"/>
                                <TextBlock x:Name="TokenText" Text="Pirate Shop token: not seen yet" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap"/>
                                <ItemsControl x:Name="PrizeList" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,2" TextWrapping="Wrap">
                                                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource Text}"/>
                                                <Run Text="{Binding Value, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="PrizeEmptyText" Text="Treasures pulled by you or your squad are listed here."
                                           Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Overlay -->
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="24,18,24,18">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Overlay" Foreground="{StaticResource Text}" FontSize="13.5"/>
                                <TextBlock x:Name="OverlayUrlText" Text="http://localhost:7777/" Foreground="{StaticResource Steel}"
                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           ToolTip="Add this address as a Browser Source in OBS or Streamlabs."/>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Title" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                <TextBox x:Name="TitleBox" Grid.Column="1" TextChanged="Title_Changed"/>
                                <TextBlock Grid.Row="1" Text="Color" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox x:Name="AccentBox" Width="82" TextChanged="Accent_Changed"/>
                                    <Border x:Name="AccentSwatch" Width="0" Height="0" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource Swatch}" Background="#F3F1EC" Tag="#F3F1EC" Margin="12,0,0,0" Click="Preset_Click"/>
                                    <Button Style="{StaticResource Swatch}" Background="#FF3D6B" Tag="#FF3D6B" Click="Preset_Click"/>
                                    <Button Style="{StaticResource Swatch}" Background="#3DDC84" Tag="#3DDC84" Click="Preset_Click"/>
                                    <Button Style="{StaticResource Swatch}" Background="#A78BFA" Tag="#A78BFA" Click="Preset_Click"/>
                                    <Button Style="{StaticResource Swatch}" Background="#FF8A3D" Tag="#FF8A3D" Click="Preset_Click"/>
                                    <Button Style="{StaticResource Swatch}" Background="#4CC9F0" Tag="#4CC9F0" Click="Preset_Click"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="Opacity" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                <Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                                      ToolTip="How see-through the overlay is. Applies to the in-game overlay and the OBS browser source.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            SmallChange="5" LargeChange="10" VerticalAlignment="Center" Margin="0,0,10,0"
                                            ValueChanged="Opacity_Changed"/>
                                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%" Foreground="{StaticResource Steel}"
                                               FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,16,0,0"/>
                            <CheckBox x:Name="InGameOverlayCheck" Content="Show the overlay in-game" Margin="0,14,0,0" Click="InGameOverlay_Toggled"/>
                            <TextBlock Text="Ctrl+Shift+O shows or hides it. Ctrl+Shift+L locks it so clicks pass through."
                                       Style="{StaticResource Label}" FontSize="11.5" Margin="26,3,0,0" TextWrapping="Wrap"/>
                            <CheckBox x:Name="TrayCheck" Content="Minimize to tray" Margin="0,12,0,0" Click="Tray_Toggled"/>
                            <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,12,0,0" Click="Startup_Toggled"/>
                            <TextBlock Text="Opens with Windows, hidden in the tray, and counts as soon as you play."
                                       Style="{StaticResource Label}" FontSize="11.5" Margin="26,3,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OverlayStatusText" Text="" Style="{StaticResource Label}" FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Live counter language -->
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="24,18,24,18">
                        <StackPanel>
                            <TextBlock Text="Live counter language" Foreground="{StaticResource Text}" FontSize="13.5"/>
                            <TextBlock Text="Choose the language Fortnite is set to, so the OCR can read the chest popup under your XP."
                                       Style="{StaticResource Label}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <Border Background="{StaticResource Bg}" CornerRadius="9" Padding="3" Margin="0,12,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OcrEn" Style="{StaticResource Pill}" Content="English" GroupName="ocrlang" Checked="OcrLang_Checked"/>
                                    <RadioButton x:Name="OcrEs" Style="{StaticResource Pill}" Content="Espa&#241;ol" GroupName="ocrlang" Checked="OcrLang_Checked"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="OcrStatusText" Text="" Style="{StaticResource Label}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Chest label (optional)" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                            <TextBox x:Name="CustomLabelBox" Margin="0,6,0,0" TextChanged="CustomLabel_Changed"
                                     ToolTip="The exact word shown under the XP when you open a chest, if the built-in one is not detected."/>
                            <TextBlock Text="Only needed if chests are not detected. Type the exact word your game shows under the XP; the status bar shows the last popup the OCR read."
                                       Style="{StaticResource Label}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Matches played before the replays -->
                    <Border Style="{StaticResource Panel}" Margin="0,16,0,0" Padding="24,18,24,18">
                        <StackPanel>
                            <TextBlock Text="Earlier matches" Foreground="{StaticResource Text}" FontSize="13.5"/>
                            <TextBlock Text="Enter the total Battle Royale matches you have played. Matches the replays do not cover are estimated from your average chests per match. Type the total, then press Update counter to apply it to the main screen."
                                       Style="{StaticResource Label}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock Text="Total matches" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox x:Name="ManualTotalBox" Width="110" MaxLength="9" Margin="0,0,10,0"
                                         TextChanged="ManualTotal_Changed" PreviewKeyDown="ManualTotal_KeyDown"/>
                                <Button x:Name="ApplyTotalButton" Content="Update counter" Style="{StaticResource Primary}" Padding="14,7"
                                        IsEnabled="False" Click="ApplyTotal_Click"
                                        ToolTip="Apply this total to the Opened counter on the main screen and the overlay."/>
                            </WrapPanel>
                            <TextBlock x:Name="EstimateText" Text="" Foreground="{StaticResource Steel}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="2,14,0,0">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="" Style="{StaticResource Label}"/>
            <TextBlock x:Name="FooterText" Text="" Style="{StaticResource Label}" FontSize="11.5"/>
        </DockPanel>
    </Grid>
    </ScrollViewer>
</Window>
